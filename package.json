{
  "name": "multara",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/with-cargo.mjs",
    "tauri:dev": "node scripts/with-cargo.mjs dev",
    "tauri:build": "node scripts/with-cargo.mjs build",
    "tauri:build:windows": "node scripts/with-cargo.mjs build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "tauri:build:macos-arm": "node scripts/with-cargo.mjs build --target aarch64-apple-darwin --bundles app,dmg",
    "tauri:build:macos-intel": "node scripts/with-cargo.mjs build --target x86_64-apple-darwin --bundles app,dmg",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset": "node scripts/reset-app.mjs",
    "screenshots": "node scripts/capture-readme-screenshots.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@iconify-json/material-icon-theme": "^1.2.71",
    "@iconify-json/vscode-icons": "^1.2.77",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.40.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "material-icon-theme": "^5.39.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "vscode-icons-js": "^11.6.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "playwright": "1.64.1"
  }
}
